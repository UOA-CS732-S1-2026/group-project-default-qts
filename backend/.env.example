PORT=5000

# Mongo connection string (no real credentials in this file)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=GrowFriend
MONGO_DB_NAME=growfriend

# JWT settings
JWT_SECRET=<generate_a_strong_random_secret_32_plus_chars>
JWT_EXPIRES_IN=7d

# Dashboard unlock rule: PET_ADULT | COINS_ONLY | PET_ADULT_AND_COINS
EGG_UNLOCK_RULE=PET_ADULT

# Leave commented unless Redis is running
# REDIS_URL=redis://localhost:6379

# Optional for debug
AUTH_DEBUG=false